import time
import hashlib

from ascon import encrypt as ascon_encrypt
from ascon import decrypt as ascon_decrypt

from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.hazmat.primitives.ciphers.aead import ChaCha20Poly1305

DATA_SIZE = 128
ITERATIONS = 50

plaintext = bytes(range(DATA_SIZE))

print("\n===== ASCON =====")

key = bytes(range(16))
nonce = bytes(range(16))
ad = b""

enc_total = 0
dec_total = 0

for _ in range(ITERATIONS):

    start = time.perf_counter()
    ciphertext = ascon_encrypt(key, nonce, ad, plaintext)
    enc_total += time.perf_counter() - start

    start = time.perf_counter()
    ascon_decrypt(key, nonce, ad, ciphertext)
    dec_total += time.perf_counter() - start

avg_enc = enc_total / ITERATIONS
avg_dec = dec_total / ITERATIONS

print(f"Enc Time: {avg_enc*1e6:.2f} us")
print(f"Dec Time: {avg_dec*1e6:.2f} us")
print(f"Throughput: {(DATA_SIZE/1024)/avg_enc:.2f} KB/s")


print("\n===== ECC + ChaCha20 =====")

private1 = ec.generate_private_key(ec.SECP256R1())
private2 = ec.generate_private_key(ec.SECP256R1())

ecdh_total = 0
enc_total = 0
dec_total = 0

for _ in range(ITERATIONS):

    start = time.perf_counter()

    shared_secret = private1.exchange(
        ec.ECDH(),
        private2.public_key()
    )

    ecdh_total += time.perf_counter() - start

    key32 = hashlib.sha256(shared_secret).digest()

    cipher = ChaCha20Poly1305(key32)

    nonce12 = b'\x00' * 12

    start = time.perf_counter()
    ciphertext = cipher.encrypt(
        nonce12,
        plaintext,
        None
    )
    enc_total += time.perf_counter() - start

    start = time.perf_counter()
    cipher.decrypt(
        nonce12,
        ciphertext,
        None
    )
    dec_total += time.perf_counter() - start

avg_ecdh = ecdh_total / ITERATIONS
avg_enc = enc_total / ITERATIONS
avg_dec = dec_total / ITERATIONS

total = avg_ecdh + avg_enc

print(f"ECDH Time: {avg_ecdh*1e6:.2f} us")
print(f"Enc Time: {avg_enc*1e6:.2f} us")
print(f"Dec Time: {avg_dec*1e6:.2f} us")
print(f"Total Setup+Encrypt: {total*1e6:.2f} us")
print(f"Throughput: {(DATA_SIZE/1024)/total:.2f} KB/s")
